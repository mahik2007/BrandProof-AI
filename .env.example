# BrandProof AI — Environment Variables
# Optional: Google Gemini API key for semantic claim checks, poster OCR and alt-text generation
GEMINI_API_KEY=

# Database configuration: defaults to SQLite at ./data/brandproof.db
# To connect PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/brandproof
DATABASE_URL=
DB_PATH=data/brandproof.db

# Host & Port settings
PORT=8000
HOST=127.0.0.1

